# Local values come from `supabase status -o env` after `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used exclusively in src/server/admin.ts and scripts/seed.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for the seed generator.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Flint presenter console (docs/PLAN.md §1.3 item 13)
DEMO_PRESENTER_PASSWORD=change-me
# HMAC secret for the presenter cookie; at least 32 characters.
DEMO_CONSOLE_SECRET=change-me-to-a-long-random-string-0000
# Shared password for seeded persona users (gm@lakeview.demo, ...).
DEMO_PERSONA_PASSWORD=change-me-persona
